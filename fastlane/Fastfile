default_platform(:ios)

platform :ios do
  # NOTE: no iOS upload lane until real IPA packaging exists.
  # The release workflow builds a ComposeApp.framework zip (not an App Store
  # IPA), so the previous upload_to_app_store lane pointed at a phantom path.
end

platform :android do
  desc "Upload Android metadata and AAB"
  lane :upload_android do |options|
    flavor = options[:flavor]
    app_id = JSON.parse(File.read('assets/flavors.json')).find { |f| f['flavorId'] == flavor }['appId']
    aab = Dir['app/build/outputs/bundle/release/*.aab'].first || Dir['app/build/outputs/bundle/*/*.aab'].first
    UI.user_error!("No release AAB found for #{flavor}; run the release build first.") if aab.nil?
    supply(
      json_key: ENV['PLAY_STORE_SERVICE_ACCOUNT_JSON'],
      package_name: app_id,
      aab: aab,
      metadata_path: "fastlane/metadata/android/#{flavor}",
      track: 'internal'
    )
  end
end
